{
	"perWorldBackup": true,
	"backupInterval": 3600,
	"restoreDelay": 30,
	"doBackupsOnEmptyServer": false,
	"shutdownBackup": true,
	"backupOldWorlds": true,
	"backupDirectoryPath": "backup/",
	"fileBlacklist": [],
	"deleteOldBackupAfterRestore": true,
	"backupsToKeep": 8,
	"maxAge": 0,
	"maxSize": 0,
	"compression": 4,
	"compressionCoreCountLimit": 2,
	"format": "ZIP",
	"permissionLevel": 4,
	"alwaysSingleplayerAllowed": true,
	"playerWhitelist": [],
	"playerBlacklist": [],
	"broadcastBackupStart": false,
	"broadcastBackupDone": true,
	"dateTimeFormat": "yyyy.MM.dd_HH-mm-ss",
	"integrityVerificationMode": "STRICT"
}